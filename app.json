{
  "expo": {
    "name": "水抜き:音波クリーナー",
    "slug": "suinuki-sonic-cleaner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A1A2A",
    "locales": {
      "ja": "./locales/ja.json",
      "en": "./locales/en.json"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yuchin0809.suinukisonic",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "plugins": [
      "expo-audio",
      "expo-localization",
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0A1A2A",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
